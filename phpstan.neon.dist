parameters:
    level: 8
    paths:
        - src


    # Pinned so results do not depend on which PHP the analyser happens to run on, and
    # checked across the whole supported range rather than one version, which is what
    # catches syntax or behaviour valid on 8.x but broken on the 7.4 floor.
    #
    # Version-specific deprecations that only apply at part of this range are not reported
    # here. Those are covered at runtime instead by bin/check-deprecations.php, which runs
    # on the actual PHP under test.
    phpVersion:
        min: 70400
        max: 80400

    treatPhpDocTypesAsCertain: false

    # Array shapes are not documented across the resource classes yet, so every array
    # parameter reports at level 6 and above. Those are a documentation gap rather than a
    # correctness one, and silencing them by identifier keeps the rest of level 8, which is
    # where the null-safety checks live. Removing this line is the next static-analysis job.
    ignoreErrors:
        - identifier: missingType.iterableValue

includes:
    - phpstan-baseline.neon
